{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grantfirefight",
  "account_id": "46f1eb7732c8b5105b494310ed3fae25",
  "main": "src/index.tsx",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "grantfirefight",
      "database_id": "ba2b26bd-1adf-4b95-945c-9bd2d61c4ed4",
      "migrations_dir": "migrations"
    }
  ],
  // Workers AI, used only for speech-to-text in voice interviews.
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "vars": {
    "CLAUDE_MODEL": "claude-opus-5-5",
    // Cloudflare Access team domain and the Worker's Access application AUD tag
    // (Worker → Access → Application values). Neither is secret.
    "ACCESS_TEAM_DOMAIN": "noisy-breeze-6b76.cloudflareaccess.com",
    "ACCESS_AUD": "21a866ff2442d42344fbac3d16905f9eda3aac7640dad5391e290c726351a327"
  },
  "observability": {
    "enabled": true
  }
}
