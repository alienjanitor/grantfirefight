{
  "name": "grantfirefight",
  "version": "0.1.0",
  "private": true,
  "description": "Grant readiness coach for volunteer fire departments: gear tracker, grant matcher, interview coach, criteria and originality checks.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "dev:remote": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test",
    "cf-typegen": "wrangler types --strict-vars=false",
    "db:migrate:local": "wrangler d1 migrations apply grantfirefight --local",
    "db:migrate:remote": "wrangler d1 migrations apply grantfirefight --remote"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alienjanitor/grantfirefight.git"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "hono": "^4.13.14",
    "jose": "^6.2.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
